# MDLBeast Member App — Environment Variables Template
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# All EXPO_PUBLIC_* vars are bundled into the client and are NOT secret —
# only use them for non-sensitive URLs / public keys. True secrets must
# stay on the backend.

# ─── PeopleVine (auth, member, bookings) ───────────────────────────────
# Used by: services/peoplevine.ts, store/authStore.ts
# Tickets: MAR-1, MAR-2, MAR-4, MAR-5, MAR-16-23, MAR-31, MAR-32, MAR-60
EXPO_PUBLIC_PEOPLEVINE_API_URL=
EXPO_PUBLIC_PEOPLEVINE_API_KEY=

# ─── Strapi v5 (headless CMS) ──────────────────────────────────────────
# Used by: services/strapi.ts
# Tickets: MAR-6, MAR-33-35, MAR-38, MAR-41, MAR-42, MAR-46, MAR-48-53, MAR-57
EXPO_PUBLIC_STRAPI_URL=
EXPO_PUBLIC_STRAPI_TOKEN=

# ─── SevenRooms (restaurant table bookings — WebView) ──────────────────
# Used by: services/sevenrooms.ts, restaurant book screen
# Tickets: MAR-39, MAR-40
EXPO_PUBLIC_SEVENROOMS_WEBSTORE_URL=
EXPO_PUBLIC_SEVENROOMS_API_KEY=

# ─── SynXis (room / stay bookings — WebView) ───────────────────────────
# Used by: services/synxis.ts, rooms screens
# Tickets: MAR-43, MAR-44, MAR-45
EXPO_PUBLIC_SYNXIS_BOOKING_URL=

# ─── MDLBeast Webstore (gym PT + shisha — WebView) ─────────────────────
# Used by: gym/book-pt.tsx, shisha/book.tsx
# Tickets: MAR-36, MAR-47
EXPO_PUBLIC_WEBSTORE_URL=

# ─── Cloudinary (image CDN — used by Strapi media) ─────────────────────
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ─── Sentry (error monitoring — production only) ───────────────────────
# Not a public var — only used at build time.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Deep-link scheme (for WebView return URLs + push notifications) ───
# Mirrors `expo.scheme` in app.json. Default placeholder until confirmed.
EXPO_PUBLIC_APP_SCHEME=mdlbeast
